<?xml version="1.0" encoding="utf-8"?>
<!-- debug 빌드에만 들어가는 시연 도구. release APK에는 포함되지 않는다. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 카툰 신호 탐침용(debug 전용). 에뮬레이터에서 읽히는 것만 골라 main 매니페스트로 올린다. -->
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />

    <application>
        <!-- 그림을 눈으로 확인하는 화면(debug 전용). adb 셸에서 띄우려면 exported여야 한다 -->
        <activity
            android:name=".debug.CartoonGalleryActivity"
            android:exported="true" />
        <!-- 차량 신호·조명 제어·차의 목소리·받아쓰기가 에뮬레이터에서 되는지 확인(debug 전용, adb 셸만) -->
        <receiver
            android:name=".debug.VehicleProbeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="kr.chatoon.app.VEHICLE_PROBE" />
            </intent-filter>
        </receiver>
        <!-- DUMP 권한은 adb 셸만 가진다. 다른 앱은 이 리시버를 부를 수 없다. -->
        <receiver
            android:name=".debug.DemoDataReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="kr.chatoon.app.DEMO_DATA" />
            </intent-filter>
        </receiver>
        <!-- 암호화된 기록을 풀어 검증 도구에 넘긴다(debug 전용, adb 셸만) -->
        <receiver
            android:name=".debug.PlainExportReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="kr.chatoon.app.EXPORT_PLAIN" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
